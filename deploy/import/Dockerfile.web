# Production frontend contains legacy source for archival compatibility, but
# src/proxy.ts denies all legacy routes under NODE_ENV=production.
FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY frontend/ ./
ARG IMPORT_API_INTERNAL_URL=http://api:8080
ENV IMPORT_API_INTERNAL_URL=$IMPORT_API_INTERNAL_URL \
    NEXT_TELEMETRY_DISABLED=1
# The repository may have no tracked assets under frontend/public yet.
# Always create the directory so the runtime COPY is safe; preserve future
# public assets automatically when they are added to the repo.
RUN mkdir -p public && npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/.next ./.next
COPY --from=build --chown=node:node /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3000"]
