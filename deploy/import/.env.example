# Safe-only configuration example for the isolated Import Compose stack.
# Never commit a real .env, actual passwords, buckets or server addresses.
# The sample subnet MUST be verified not to overlap any existing Docker/VPS
# network before creating it. It is NOT guaranteed safe on every Hostinger VPS.
WATHIQA_PRIVATE_SUBNET=172.29.241.0/24
WATHIQA_WEB_IP=172.29.241.20
WATHIQA_PRIVATE_ROOT=/opt/wathiqa/import-private
WATHIQA_SECRETS_ROOT=/opt/wathiqa/import-secrets
RESTIC_REPOSITORY=s3:https://YOUR-S3-COMPATIBLE-ENDPOINT/YOUR-PRIVATE-BUCKET/wathiqa-import
