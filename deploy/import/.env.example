# Safe-only configuration example for the isolated Import Compose stack.
# Never commit a real .env, actual passwords, buckets or server addresses.
# The sample subnet MUST be verified not to overlap any existing Docker/VPS
# network before creating it. It is NOT guaranteed safe on every Hostinger VPS.
WATHIQA_PRIVATE_SUBNET=172.29.241.0/24
WATHIQA_WEB_IP=172.29.241.20
WATHIQA_PRIVATE_ROOT=/opt/wathiqa/import-private
WATHIQA_SECRETS_ROOT=/opt/wathiqa/import-secrets
# Apply pending Import EF migrations before API starts serving.
# Enabled by default even when omitted from existing Dokploy .env files.
# Disable only if the operator has already applied all pending migrations.
WATHIQA_IMPORT_AUTO_MIGRATE=true
RESTIC_REPOSITORY=s3:https://YOUR-S3-COMPATIBLE-ENDPOINT/YOUR-PRIVATE-BUCKET/wathiqa-import
# Optional paid ShipsGo live ocean tracking; configure the REAL value only in
# Dokploy's private Environment settings or gitignored deploy/import/.env.
# A blank value keeps live provider activation disabled without blocking startup.
WATHIQA_SHIPSGO_API_KEY=
# New V2 API credential; new activations prefer V2 when configured.
# Retain the legacy key while existing V1.2 paid IDs remain in the database.
WATHIQA_SHIPSGO_V2_TOKEN=
# Different secret than the API token; configure the same value in ShipsGo's
# webhook subscription and in Dokploy. Leave blank to reject webhooks.
WATHIQA_SHIPSGO_WEBHOOK_SECRET=
# In-depth HTTP + sanitized SQL + ShipsGo diagnostics (console/Dokploy logs).
# Never stores these diagnostic records in the application database.
WATHIQA_CONSOLE_LOGS_ENABLED=true
